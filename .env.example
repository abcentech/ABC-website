# Public website works without these variables; enquiries go to WhatsApp.
# Optional administration + aggregate analytics service:
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:3001
# NODE_ENV=production requires an https PUBLIC_ORIGIN and secure cookie transport.
DATA_DIR=/workspace/ark-builders-data
# ADMIN_PASSWORD_HASH must be generated securely; no default credentials.
# ADMIN_PASSWORD_HASH=
# Build-time settings:
# SITE_ORIGIN=https://arkbuilders.com.ng
# CONTENT_FILE=/absolute/path/to/approved/ark-content.json
